# Backend settings (app/core/config.py). Copy to backend/.env and fill in.
# Every setting is read from the environment; this file is only for local dev.

# --- Required ---------------------------------------------------------------
# Postgres. The prefix must be postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/belonging
# Long random string; signs session cookies. No default — startup fails if unset.
JWT_SECRET=

# --- Site / cookies ---------------------------------------------------------
# Public origin of the site. Links in emails and .ics files are built from it.
FRONTEND_ORIGIN=http://localhost:3000
# "" locally; "/api" when the backend sits behind the site's /api path.
ROOT_PATH=
# true behind HTTPS (production).
COOKIE_SECURE=false
COOKIE_NAME=kwcc_session
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Uploads (event images, posters, profile pictures) ----------------------
# "supabase" (default) or "local".
STORAGE_BACKEND=supabase
# local: folder files are written to (created if missing). Must persist
# across deploys and be writable by the backend process.
UPLOAD_DIR=uploads
# local: URL prefix stored links are built from. Empty = FRONTEND_ORIGIN +
# ROOT_PATH + /uploads, served by the backend. Set it to serve UPLOAD_DIR from
# your web server instead, e.g. https://example.org/uploads
UPLOAD_PUBLIC_URL=
# supabase: project URL and SECRET key (server-side only), public bucket.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_IMAGE_BUCKET=event-images

# --- Mail (password resets, invitations, reminders) -------------------------
# Unset = nothing is sent and messages are written to the log. Never leave
# unset in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=
MAIL_FROM_NAME=The Belonging Collective

# --- Reminders cron ---------------------------------------------------------
# Sent as "Authorization: Bearer <CRON_SECRET>" to GET /internal/reminders
# (daily). Unset = the endpoint refuses to run.
CRON_SECRET=

# --- Google Calendar (optional) ---------------------------------------------
# OAuth web client. Unset = calendar buttons use the subscription feed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default: FRONTEND_ORIGIN + ROOT_PATH + /google-calendar/callback
GOOGLE_REDIRECT_URI=
