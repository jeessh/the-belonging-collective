# Frontend settings. Copy to frontend/.env.local for local dev.
# NEXT_PUBLIC_* values are baked in at build time — rebuild after changing them.

# Where the browser calls the API. "/api" in production (same origin as the
# site, required for the auth cookie); http://localhost:8000 locally.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public origin, used for canonical URLs, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Absolute API base for server-side rendering, e.g. https://example.org/api
# or an internal address such as http://127.0.0.1:8000.
INTERNAL_API_URL=http://localhost:8000
